          "expectExit": 0,
          "stdout": [
            "DONE T1"
          ]
        },
        {
          "script": "skills/project-orchestrator/scripts/task.mjs",
          "args": [
            "next",
            "--file",
            "ledger.json"
          ],
          "expectExit": 0,
          "stdout": [
            "NEXT T2"
          ]
        },
        {
          "script": "skills/project-orchestrator/scripts/task.mjs",
          "args": [
