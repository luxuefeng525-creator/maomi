            "--file",
            "ledger.json",
            "--id",
            "T1",
            "--title",
            "需求"
          ],
          "expectExit": 0,
          "stdout": [
            "ADD T1"
          ]
        },
        {
          "script": "skills/project-orchestrator/scripts/task.mjs",
          "args": [
            "add",
            "--file",
            "ledger.json",
            "--id",
            "T2",
            "--title",
            "实现",
            "--deps",
            "T1"
          ],
          "expectExit": 0,
          "stdout": [
            "ADD T2"
          ]
        },
        {
          "script": "skills/project-orchestrator/scripts/task.mjs",
          "args": [
            "next",
            "--file",
            "ledger.json"
          ],
          "expectExit": 0,
          "stdout": [
            "NEXT T1"
          ]
        },
        {
          "script": "skills/project-orchestrator/scripts/task.mjs",
          "args": [
            "start",
            "--file",
            "ledger.json",
            "--id",
            "T1"
          ],
          "expectExit": 0,
          "stdout": [
            "START T1"
          ]
        },
        {
          "script": "skills/project-orchestrator/scripts/task.mjs",
